{
  "manifest_version": 3,
  "name": "Kamus Mini",
  "version": "1.1",
  "description": "Cari kunci jawaban dari bank soal secara instan dengan blok teks dan klik kanan, atau selesaikan kuis otomatis dengan Direct AI.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/katex.min.js", "lib/auto-render.min.js", "lib/katex.min.css", "lib/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bypass.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ocr.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pusat Kunci Jawaban"
  }
}
